{
  "info": {
    "_postman_id": "expense-2-0-0",
    "name": "Expense Service - Payments V2 (2.0.0)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Payments V2 period-aware bill search and V2 uniqueness guard."
  },
  "item": [
    {
      "name": "Create Bill (V2 - period)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{expense_host}}/expense/bill/v1/_create?tenantId={{tenantId}}",
          "host": ["{{expense_host}}"],
          "path": ["expense", "bill", "v1", "_create"],
          "query": [
            { "key": "tenantId", "value": "{{tenantId}}" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"RequestInfo\": { \"apiId\": \"postman\", \"ver\": \"1.0\" },\n  \"Bill\": [\n    {\n      \"tenantId\": \"{{tenantId}}\",\n      \"registerId\": \"{{registerId}}\",\n      \"billingPeriodId\": \"{{billingPeriodId}}\",\n      \"billDate\": {{billDate}},\n      \"billingType\": \"PERIODIC\",\n      \"billDetails\": [\n        { \"amount\": 1000, \"fromPeriod\": {{fromDate}}, \"toPeriod\": {{toDate}}, \"lineItems\": [ { \"headCode\": \"WAGE\", \"amount\": 1000, \"type\": \"DEBIT\" } ] }\n      ]\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Search Bills (Payments V2 filters)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{expense_host}}/expense/bill/v1/_search?tenantId={{tenantId}}&billingPeriodIds={{billingPeriodId}}&billingType=PERIODIC&reportStatus=APPROVED&isAggregate=false",
          "host": ["{{expense_host}}"],
          "path": ["expense", "bill", "v1", "_search"],
          "query": [
            { "key": "tenantId", "value": "{{tenantId}}" },
            { "key": "billingPeriodIds", "value": "{{billingPeriodId}}" },
            { "key": "billingType", "value": "PERIODIC" },
            { "key": "reportStatus", "value": "APPROVED" },
            { "key": "isAggregate", "value": "false" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"RequestInfo\": { \"apiId\": \"postman\", \"ver\": \"1.0\" }\n}"
        }
      }
    },
    {
      "name": "Bill Approval (Signature Capture)",
      "item": [
        {
          "name": "1. Upload Signature",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('signatureFileStoreId', body.signatureFileStoreId);",
                  "    console.log('Captured signatureFileStoreId=' + body.signatureFileStoreId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{expense_host}}/expense/bill/v1/signature/_upload",
              "host": ["{{expense_host}}"],
              "path": ["expense", "bill", "v1", "signature", "_upload"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "tenantId", "type": "text", "value": "{{tenantId}}" }
              ]
            },
            "description": "Select a PNG/JPG/JPEG under 5MB for the 'file' field. On success this test script auto-captures signatureFileStoreId into a collection variable for the next requests."
          }
        },
        {
          "name": "2. Approve Bill - Bulk Update Status (happy path)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{expense_host}}/expense/bill/v1/_bulkupdatestatus",
              "host": ["{{expense_host}}"],
              "path": ["expense", "bill", "v1", "_bulkupdatestatus"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"RequestInfo\": {\n    \"apiId\": \"postman\",\n    \"ver\": \"1.0\",\n    \"userInfo\": {\n      \"uuid\": \"{{approverUuid}}\",\n      \"roles\": [ { \"code\": \"PAYMENT_APPROVER\" } ]\n    }\n  },\n  \"tenantId\": \"{{tenantId}}\",\n  \"billIds\": [ \"{{billId}}\" ],\n  \"status\": \"PAYMENT_IN_PROGRESS\",\n  \"workflow\": { \"action\": \"PAYMENT_INITIATION\" },\n  \"approvalSignature\": {\n    \"printedName\": \"Jane Doe\",\n    \"signatureMethod\": \"DRAWN\",\n    \"signatureFileStoreId\": \"{{signatureFileStoreId}}\"\n  }\n}"
            },
            "description": "billId must currently be in REVIEWED status. Requires request 1 to have run first so {{signatureFileStoreId}} is set."
          }
        },
        {
          "name": "3. Approve Bill - Missing Signature (expect 4xx blocked)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{expense_host}}/expense/bill/v1/_bulkupdatestatus",
              "host": ["{{expense_host}}"],
              "path": ["expense", "bill", "v1", "_bulkupdatestatus"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"RequestInfo\": {\n    \"apiId\": \"postman\",\n    \"ver\": \"1.0\",\n    \"userInfo\": {\n      \"uuid\": \"{{approverUuid}}\",\n      \"roles\": [ { \"code\": \"PAYMENT_APPROVER\" } ]\n    }\n  },\n  \"tenantId\": \"{{tenantId}}\",\n  \"billIds\": [ \"{{billId}}\" ],\n  \"status\": \"PAYMENT_IN_PROGRESS\",\n  \"workflow\": { \"action\": \"PAYMENT_INITIATION\" }\n}"
            },
            "description": "No approvalSignature supplied. Expect the bill to be rejected (EG_EXPENSE_APPROVAL_SIGNATURE_REQUIRED) and remain in REVIEWED status."
          }
        },
        {
          "name": "4. Approve Bill - Wrong Role (expect unauthorized)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{expense_host}}/expense/bill/v1/_bulkupdatestatus",
              "host": ["{{expense_host}}"],
              "path": ["expense", "bill", "v1", "_bulkupdatestatus"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"RequestInfo\": {\n    \"apiId\": \"postman\",\n    \"ver\": \"1.0\",\n    \"userInfo\": {\n      \"uuid\": \"{{approverUuid}}\",\n      \"roles\": [ { \"code\": \"PAYMENT_REVIEWER\" } ]\n    }\n  },\n  \"tenantId\": \"{{tenantId}}\",\n  \"billIds\": [ \"{{billId}}\" ],\n  \"status\": \"PAYMENT_IN_PROGRESS\",\n  \"workflow\": { \"action\": \"PAYMENT_INITIATION\" },\n  \"approvalSignature\": {\n    \"printedName\": \"Jane Doe\",\n    \"signatureMethod\": \"DRAWN\",\n    \"signatureFileStoreId\": \"{{signatureFileStoreId}}\"\n  }\n}"
            },
            "description": "Caller has PAYMENT_REVIEWER, not PAYMENT_APPROVER. Expect EG_EXPENSE_APPROVAL_UNAUTHORIZED."
          }
        },
        {
          "name": "5. Search Bill - verify approvals[]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{expense_host}}/expense/bill/v1/_search",
              "host": ["{{expense_host}}"],
              "path": ["expense", "bill", "v1", "_search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"RequestInfo\": { \"apiId\": \"postman\", \"ver\": \"1.0\" },\n  \"billCriteria\": {\n    \"ids\": [ \"{{billId}}\" ],\n    \"tenantId\": \"{{tenantId}}\"\n  }\n}"
            },
            "description": "After request 2 succeeds (and the persister has processed the Kafka message), bills[0].approvals should contain the printed name, role, signatureMethod, signatureFileStoreId, and approvedTime."
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "approverUuid", "value": "approver-uuid-1" },
    { "key": "billId", "value": "" },
    { "key": "signatureFileStoreId", "value": "" }
  ]
}
